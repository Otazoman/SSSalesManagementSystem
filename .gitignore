# ====================================================================
# Cloudflare / Wrangler (D1, R2, Workers) 一時ファイル・ローカルDB
# ====================================================================
.wrangler/
.miniflare/
*.sqlite
*.sqlite-journal

# ====================================================================
# GitHub Codespaces / Dev Containers 一時ファイル
# ====================================================================
.devcontainer/.apps.github.dev.json
.vscode/launch.json
# ※ .devcontainer.json 自体は共有するためにGitに含めるので除外しません

# ====================================================================
# Node.js 依存パッケージ（パッケージの実体はクラウド上にあるため除外）
# ====================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ====================================================================
# 環境変数・秘密鍵（セキュリティ上の最重要除外項目）
# ====================================================================
.env
.env.local
.env.*.local
*.pem
*.key

# ====================================================================
# フロントエンドビルド成果物（Vite/Reactなどの出力フォルダ）
# ====================================================================
dist/
.pages/
.out/
.next/

# ====================================================================
# OS・エディタの一時ファイル
# ====================================================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.aider*
.claude

REFRACTOR_PLAN.md
# ====================================================================
# Terraform(状態ファイル・ローカルの変数値・プラン。アカウントIDや各リソースのIDを含む)
# ※ .terraform.lock.hcl は共有するためGitに含める
# ====================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log

# wrangler.jsonc は wrangler.jsonc.example から infra/scripts/sync-wrangler.mjs で作る(実IDを含むためGit管理外)
packages/backend/wrangler.jsonc
packages/frontend/wrangler.jsonc
