{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev --test-scheduled",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && rm -rf drizzle && mkdir -p drizzle/main drizzle/log",
    "db:generate-main": "drizzle-kit generate --schema=./src/db/schema.ts --out=./drizzle/main --dialect=sqlite",
    "db:migrate-main": "wrangler d1 migrations apply my-erp-db --local",
    "db:push-main": "npm run db:generate-main && npm run db:migrate-main",
    "db:seed-main": "wrangler d1 execute my-erp-db --local --file=./drizzle/main/seed.sql",
    "db:generate-log": "drizzle-kit generate --schema=./src/db/audit-schema.ts --out=./drizzle/log --dialect=sqlite",
    "db:migrate-log": "wrangler d1 migrations apply my-erp-log-db --local",
    "db:push-log": "npm run db:generate-log && npm run db:migrate-log",
    "db:generate-otp": "drizzle-kit generate --schema=./src/db/otp-schema.ts --out=./drizzle/otp --dialect=sqlite",
    "db:migrate-otp": "wrangler d1 migrations apply my-erp-otp-db --local",
    "db:push-otp": "npm run db:generate-otp && npm run db:migrate-otp",
    "db:generate-journal": "drizzle-kit generate --schema=./src/db/journal-schema.ts --out=./drizzle/journal --dialect=sqlite",
    "db:migrate-journal": "wrangler d1 migrations apply my-erp-journal-db --local",
    "db:push-journal": "npm run db:generate-journal && npm run db:migrate-journal",
    "db:generate-deals": "drizzle-kit generate --schema=./src/db/deals-schema.ts --out=./drizzle/deals --dialect=sqlite",
    "db:migrate-deals": "wrangler d1 migrations apply my-erp-deals-db --local",
    "db:push-deals": "npm run db:generate-deals && npm run db:migrate-deals",
    "db:generate-ui": "drizzle-kit generate --schema=./src/db/ui-schema.ts --out=./drizzle/ui --dialect=sqlite",
    "db:migrate-ui": "wrangler d1 migrations apply my-erp-ui-db --local",
    "db:push-ui": "npm run db:generate-ui && npm run db:migrate-ui",
    "db:push": "npm run db:push-main && npm run db:push-log && npm run db:push-otp && npm run db:push-journal && npm run db:push-deals && npm run db:push-ui",
    "db:rebuild": "npm run db:reset && npm run db:push"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/valibot-validator": "^0.6.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@valibot/to-json-schema": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.23",
    "hono-openapi": "^1.3.1",
    "mimetext": "^3.0.28",
    "pdf-lib": "^1.17.1",
    "smtp-client": "^0.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "^12.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
